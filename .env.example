# Copy this file to .env and fill in your own values. Never commit .env.

# CoinGecko Demo API key (https://www.coingecko.com/en/api). Required for live data.
COINGECKO_API_KEY=

# How long fetched market data is reused before a new API request is made.
CACHE_TTL_SECONDS=900

# Per-request HTTP timeout.
HTTP_TIMEOUT_SECONDS=10

# Maximum retries after a timeout, connection error, HTTP 429 or HTTP 5xx.
HTTP_MAX_RETRIES=3
